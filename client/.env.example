# Frontend Environment Variables (Vite)
# Note: Vite exposes all VITE_* variables to the browser client bundle.
# Do NOT put secret tokens, database credentials, or private API keys here.

# Backend API Base URL (leave empty in local dev to use Vite dev proxy '/api')
# In production, set to your live backend URL (e.g. https://api.yourdomain.com/api)
VITE_API_URL=

# Socket.IO Server URL (leave empty in local dev to default to http://localhost:5000)
# In production, set to your live WebSocket server URL (e.g. https://api.yourdomain.com)
VITE_SOCKET_URL=
